      <ipxact:busType vendor="test.org" library="bus" name="sbus" version="1.0"/>
      <ipxact:abstractionTypes>
        <ipxact:abstractionType>
          <ipxact:abstractionRef vendor="test.org" library="bus" name="sbus_rtl" version="1.0"/>
