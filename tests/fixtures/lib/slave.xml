<?xml version="1.0" encoding="UTF-8"?>
<!-- valid_ni is active low and inverted by the port map, ERR is tied off, READY is left to the
     abstraction's default, DEBUG has no receiver here, and rdata_o is split by a part select. -->
<ipxact:component xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2022">
  <ipxact:vendor>test.org</ipxact:vendor>
  <ipxact:library>ip</ipxact:library>
