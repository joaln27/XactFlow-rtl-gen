  </ipxact:busInterfaces>
  <ipxact:model>
    <ipxact:views>
      <ipxact:view>
        <ipxact:name>rtl</ipxact:name>
        <ipxact:componentInstantiationRef>rtl_inst</ipxact:componentInstantiationRef>
      </ipxact:view>
    </ipxact:views>
    <ipxact:instantiations>
      <ipxact:componentInstantiation>
        <ipxact:name>rtl_inst</ipxact:name>
        <ipxact:moduleName>slave</ipxact:moduleName>
        <ipxact:moduleParameters>
          <ipxact:moduleParameter dataType="int"><ipxact:name>GAIN</ipxact:name><ipxact:value>GAIN</ipxact:value></ipxact:moduleParameter>
          <ipxact:moduleParameter dataType="int"><ipxact:name>OUT_W</ipxact:name><ipxact:value>OUT_W</ipxact:value></ipxact:moduleParameter>
        </ipxact:moduleParameters>
